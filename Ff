/* ==========================================
   PROJECT ACTION BUTTONS FIX
   (View / Details / Code)
========================================== */

.project-actions {
  display: flex;
  justify-content: center;
  gap: 18px;
  margin-top: 18px;
}

/* Remove default ugly button style */
.project-actions button,
.project-actions a {
  all: unset; /* removes default browser style */
  cursor: pointer;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 1rem;
  font-weight: 600;

  color: white;
  padding: 10px 18px;
  border-radius: 30px;

  transition: 0.3s ease;
}

/* Neon Border Look */
.project-actions button,
.project-actions a {
  position: relative;
  background: #0b0f1a;
  z-index: 1;
}

/* Border Gradient */
.project-actions button::before,
.project-actions a::before {
  content: "";
  position: absolute;
  inset: -2px;
  border-radius: 35px;

  background: linear-gradient(90deg, #00f2ff, #8f00ff, #00ff99, #00f2ff);
  background-size: 400% 400%;
  animation: btnBorderMove 3s linear infinite;

  z-index: -2;
}

/* Inner background */
.project-actions button::after,
.project-actions a::after {
  content: "";
  position: absolute;
  inset: 2px;
  border-radius: 30px;
  background: #0b0f1a;
  z-index: -1;
}

/* Hover Glow */
.project-actions button:hover,
.project-actions a:hover {
  transform: translateY(-3px) scale(1.05);
  box-shadow: 0 0 15px rgba(0, 242, 255, 0.6),
              0 0 22px rgba(143, 0, 255, 0.4);
}

/* Border Animation */
@keyframes btnBorderMove {
  0% { background-position: 0% 50%; }
  100% { background-position: 400% 50%; }
}

/* Icon space */
.project-actions i {
  margin-right: 6px;
}
